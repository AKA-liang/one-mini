# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# MiniMax (Primary LLM)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Volcengine (Doubao) - Optional, for multimodal later
VOLC_ACCESS_KEY=your_volc_access_key
VOLC_SECRET_KEY=your_volc_secret_key
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_ID=doubao-seed-2-0-pro

# DeepSeek - Optional, for deep reasoning later
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Cookies for web scraping (auto-extracted from browser)
CHANMAMA_COOKIE=
ALIBABA_1688_COOKIE=

# App
APP_HOST=0.0.0.0
APP_PORT=8001